[Unit]
Description=TUXEDO Uniwill fan, EC profile and keyboard control (tuxedo-controld)
Documentation=https://github.com/AndrewDemsDS/tuxedo-control
After=systemd-modules-load.service
# One fan controller at a time.
Conflicts=tccd.service tailord.service
# Retry while uniwill_wmi comes up at boot, then give up instead of restarting forever. With
# RestartSec=3 the default limit (5 starts in 10 s) never trips, so a daemon that can never
# start (missing interface, kernel oops on open) looped every 3 s all night.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/tuxedo-controld /etc/tuxedo-control/config.json
Restart=on-failure
RestartSec=3
StateDirectory=tuxedo-control
Nice=-5
# SIGTERM makes the daemon hand the fan back to the EC before exiting. The first fan write
# after start re-initialises the EC fan tables and takes ~13 s on the reference board; a stop
# that lands inside it must not be cut short by SIGKILL, or the fan is never handed back.
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
